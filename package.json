{
  "name": "worksheet",
  "productName": "Worksheet",
  "version": "0.1.5",
  "description": "점 모눈종이 무한 캔버스 위에 워크박스를 놓고 연결하고 계산하는 데스크톱 워크시트 프로그램",
  "author": "msward0927",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "dist:win": "npm run build && electron-builder --win portable zip --x64",
    "dist:linux": "npm run build && electron-builder --linux dir"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "zustand": "^4.5.5"
  },
  "build": {
    "appId": "com.msward0927.worksheet",
    "productName": "Worksheet",
    "copyright": "msward0927",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Worksheet-${version}-portable.exe"
    },
    "linux": {
      "target": [
        "dir"
      ]
    }
  }
}
